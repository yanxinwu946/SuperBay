/* Material chrome and opaque content. No blur filters or repaint animations. */
QMainWindow[nativeBackdrop="true"] { background: transparent; }
#GlassCanvas { background: transparent; }
#TopBar, #SideBar, #DetailPanel {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @glassTop,stop:1 @glassBottom);
    border: 1px solid @glassEdge; border-top-color: @glassHighlight; border-radius: 18px;
}
#TopBar { min-height: 56px; max-height: 56px; }
#Brand { font-size: 16px; font-weight: 600; }
#WorkspaceBtn { background: transparent; color: @text; border: none; border-radius: 14px; padding: 7px 12px; }
#WorkspaceBtn:hover { background: @selection; color: @text; }
#WorkspaceBtn[active="true"] { background: @surface; color: @text; border: 1px solid @glassEdge; }
#TopIconBtn { border: none; border-radius: 12px; }
#TopIconBtn:hover, #TopIconBtn:checked { background: @selection; }
#SearchBar { background: @surface; color: @text; border: 1px solid @glassEdge; border-radius: 14px; padding: 7px 12px; }
#SearchBar:focus { border: 1px solid @muted; background: @surface; }
#SideScroll, #SideContent { background: transparent; }
#SideBar #NavButton { border: none; border-radius: 12px; background: transparent; padding: 0; }
#SideBar #NavButton:hover { background: @selection; }
#SideBar #NavButton:checked { background: @surface; border: 1px solid @glassEdge; }
#NavName { font-weight: 400; color: @text; }
#NavButton:checked #NavName { font-weight: 600; }
#NavCount { color: @text; font-size: 11px; }
#Content { background: @contentSurface; border: 1px solid @glassEdge; border-radius: 20px; }
#ContentTitle { font-size: 20px; font-weight: 600; padding: 0; border: none; }
#ContentSub { padding: 0; color: @muted; font-size: 12px; }
#Content #GhostBtn { background: @surface; border: 1px solid @glassEdge; border-radius: 12px; padding: 6px 12px; }
#Content QComboBox { border-radius: 12px; }
#EntryView { background: transparent; border: none; outline: none; }
#DetailPanel { border-radius: 18px; }
#DetailName { font-size: 18px; font-weight: 600; }
#StatusBar { background: transparent; border: none; }
#StatusOk { color: @text; font-weight: 400; }
#StatusText { color: @text; }
#RuntimeTable { border: 1px solid @glassEdge; border-radius: 16px; background: @surface; }
#RuntimeTable QHeaderView::section { background: @surface; border: none; border-bottom: 1px solid @glassEdge; padding: 10px 8px; }
QDialog #GhostBtn { border-radius: 12px; border-color: @glassEdge; color: @text; background: @surface; }
QDialog #PrimaryBtn { border-radius: 12px; background: @primary; color: @primaryText; border: none; }
QLineEdit, QComboBox { border-radius: 12px; }
QMenu { border-radius: 12px; border-color: @glassEdge; }

/* Preferences share the main window's material, edges and control rhythm. */
#SettingsDialog { background: @base; }
#SettingsRail {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @glassTop,stop:1 @glassBottom);
    border: none; border-right: 1px solid @glassEdge;
}
#SettingsBrand { font-size: 18px; font-weight: 600; color: @text; }
#SettingsNav::item { border: 1px solid transparent; border-radius: 12px; padding: 11px 12px; }
#SettingsNav::item:hover { background: @selection; color: @text; }
#SettingsNav::item:selected { background: @surface; border: 1px solid @glassEdge; color: @text; }
#SettingsScroll, #SettingsPage { background: @base; border: none; }
#SettingsPageTitle { font-size: 24px; font-weight: 600; }
#SettingsCard {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @glassTop,stop:1 @glassBottom);
    border: 1px solid @glassEdge; border-top-color: @glassHighlight; border-radius: 18px;
}
#SettingsFooter { background: @contentSurface; border-top: 1px solid @glassEdge; }
#SettingsDialog QLineEdit, #SettingsDialog QComboBox { border-color: @glassEdge; border-radius: 12px; }
#SettingsDialog QLineEdit:focus, #SettingsDialog QComboBox:focus { border-color: @primary; }
#SettingsDialog QLineEdit[invalid="true"] { border-color: #f0524f; }
#SettingsDialog QPushButton { border-radius: 12px; }
#SettingsDialog QDialogButtonBox QPushButton { background: @primary; color: @primaryText; border: none; border-radius: 12px; }
#SettingsDialog QDialogButtonBox QPushButton:hover { background: @primary; border: 1px solid @glassHighlight; }

/* Shortcut management shares the preference cards and toolbar material. */
#ShortcutManager { background: @base; }
#ShortcutManager #ContentTitle { font-size: 24px; font-weight: 600; }
#ShortcutCard {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @glassTop,stop:1 @glassBottom);
    border: 1px solid @glassEdge; border-top-color: @glassHighlight; border-radius: 18px;
}
#ShortcutList, #ShortcutList::item { background: transparent; border: none; outline: none; }
#ShortcutCount { color: @muted; font-size: 12px; }
#ShortcutEmpty { color: @muted; font-size: 13px; padding: 24px; }
#ShortcutManager #GhostBtn { min-height: 20px; padding: 7px 14px; font-weight: 500; }
#ShortcutManager #GhostBtn:disabled { color: @muted; background: transparent; border-color: @glassEdge; }
#ShortcutManager #PrimaryBtn { min-width: 64px; min-height: 20px; padding: 7px 16px; font-weight: 600; }

/* A denser workspace keeps tool cards and details visually connected. */
#TopBar, #SideBar, #DetailPanel { border-radius: 12px; }
#Content { border-radius: 12px; }
#ContentTitle { font-size: 20px; font-weight: 600; }
#SideBar #NavButton { border-radius: 8px; }
#SearchBar { border-radius: 10px; }


/* One size contract; Qt owns widget geometry, QSS owns appearance. */
QPushButton#ActionIconButton, QPushButton#TopIconBtn {
    padding: 0; margin: 0; min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px;
    border: 1px solid transparent; border-radius: 8px; background: transparent;
}
QPushButton#ActionIconButton:hover, QPushButton#TopIconBtn:hover { background: rgba(60, 181, 111, 0.12); border-color: transparent; }
QPushButton#ActionIconButton:checked, QPushButton#TopIconBtn:checked { background: rgba(60, 181, 111, 0.16); border-color: transparent; }
QPushButton#ActionIconButton:pressed, QPushButton#TopIconBtn:pressed { background: rgba(60, 181, 111, 0.22); border-color: transparent; }
QPushButton#ActionIconButton:focus, QPushButton#TopIconBtn:focus { background: rgba(60, 181, 111, 0.16); border-color: transparent; }
QPushButton#ActionIconButton:disabled, QPushButton#TopIconBtn:disabled { background: transparent; border-color: transparent; }
QToolTip { color: @text; background: @surface; border: 1px solid @border; padding: 6px 8px; }
#ToolbarDivider { background: @border; border: none; }

/* Text action rhythm: 36px regular, 32px compact, 40px primary detail actions. */
QPushButton#GhostBtn, QPushButton#PrimaryBtn, QPushButton#LaunchEditBtn,
#Content QPushButton#GhostBtn, QDialog QPushButton#GhostBtn,
QDialog QPushButton#PrimaryBtn, #SettingsDialog QPushButton#PrimaryBtn,
#ShortcutManager QPushButton#GhostBtn, #ShortcutManager QPushButton#PrimaryBtn {
    min-height: 20px; padding: 7px 12px; border-radius: 8px;
    font-size: 13px; font-weight: 500;
}
QPushButton#GhostBtn, QPushButton#LaunchEditBtn { background: @surface; color: @text; border: 1px solid @glassEdge; }
QPushButton#GhostBtn:hover, QPushButton#LaunchEditBtn:hover { background: @selection; border-color: @glassEdge; }
QPushButton#GhostBtn:pressed, QPushButton#LaunchEditBtn:pressed { background: @selection; }
QPushButton#PrimaryBtn { background: @primary; color: @primaryText; border: 1px solid transparent; }
QPushButton#PrimaryBtn:hover { background: @primary; border-color: @glassHighlight; }
QPushButton#MiniBtn { min-height: 20px; padding: 5px 10px; font-size: 12px; font-weight: 400; border-radius: 8px; border: 1px solid @glassEdge; background: @surface; color: @text; }
QPushButton#MiniBtn:hover { background: @selection; }
QPushButton#MiniBtn:pressed { background: @selection; }
#DetailPanel QPushButton#PrimaryBtn, #DetailPanel QPushButton#GhostBtn { min-height: 22px; padding: 8px 12px; font-size: 13px; border-radius: 8px; }
QPushButton#GhostBtn:disabled, QPushButton#MiniBtn:disabled, QPushButton#PrimaryBtn:disabled { color: @muted; background: @base; border-color: transparent; }
